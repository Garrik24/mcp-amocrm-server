# AmoCRM Configuration
# ВАЖНО: Никогда не коммитьте файл .env с реальными данными!

# Обязательные переменные
AMOCRM_SUBDOMAIN=your_subdomain_here
AMOCRM_ACCESS_TOKEN=your_long_term_access_token_here

# Секрет для MCP эндпоинтов (/{MCP_PATH_SECRET}/mcp)
MCP_PATH_SECRET=your_random_secret_path_here

# Секрет для REST API /api/* эндпоинтов (Bearer token или X-API-Key)
# Если не задан, все запросы к /api/* будут отклонены (fail closed)
API_SECRET_KEY=your_random_api_key_here_minimum_32_characters

# Опциональные переменные
VOICE_WEBHOOK_URL=https://voice-transcription-production.up.railway.app/webhook/amocrm
